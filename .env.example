# Orlo docs, local development. `nuxt dev` loads this file; a deployed container
# does not, so set the same variables in Coolify. Use the NUXT_ names.
NUXT_AUTH_MODE=public
NUXT_F0_MODE=docs
NUXT_PUBLIC_SITE_NAME=Orlo
NUXT_PUBLIC_SITE_DESCRIPTION=Orlo documentation: production AI evals, evidence, and release guardrails
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_GTAG_ID=
# Private mode only (not used for docs.useorlo.com)
# NUXT_JWT_SECRET=
# NUXT_AWS_REGION=us-east-1
# NUXT_AWS_ACCESS_KEY_ID=
# NUXT_AWS_SECRET_ACCESS_KEY=
# NUXT_EMAIL_FROM=no-reply@useorlo.com
# Optional GitHub webhook for content sync
# GITHUB_WEBHOOK_SECRET=
